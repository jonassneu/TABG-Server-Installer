<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for client mod logic. Builds against the mods, so it needs TabgClientDir. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(TabgSharedDir)/CustomGameSkins.Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/ProximityChat.Client/ProximityChat.Client.csproj" />
    <ProjectReference Include="../../src/AdminRadar.Client/AdminRadar.Client.csproj" />
    <ProjectReference Include="../../src/Destruction/Destruction.csproj" />
    <ProjectReference Include="../../src/PrincessMode/PrincessMode.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The radar's messages carry Unity vectors (plain structs, no engine needed). -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TabgClientDir)/TotallyAccurateBattlegrounds_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
